# Arquivo de producao (docker-compose.prod.yml). Copie para ".env.production" na VM,
# preencha os valores reais e NUNCA versione ("ja esta no .gitignore).
# Uso: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# --- Postgres (container "postgres") ---
POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-unica

# --- Backend (container "backend", le todas as variaveis abaixo) ---
NODE_ENV=production
PORT=3000
# Conecta no container "postgres" pelo nome do servico (mesma rede Docker) - nao mude o host,
# so a senha (tem que ser igual ao POSTGRES_PASSWORD acima).
DATABASE_URL=postgresql://mbd:troque-por-uma-senha-forte-e-unica@postgres:5432/meu_bolso_digital
DATABASE_SSL=false

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-48-bytes

JWT_EXPIRES_IN=7d

# Endereco publico do frontend (Vercel ou o dominio proprio), liberado no CORS.
# Aceita varias origens separadas por virgula (ex.: dominio novo + endereco antigo durante uma
# migracao, sem downtime). A PRIMEIRA e' a principal (usada no link do e-mail de recuperacao).
FRONTEND_URL=https://meubolso.lumvix.com.br

# --- E-mail de recuperacao de senha ---
# Opcao A (sem dominio): SMTP, ex.: Gmail com "senha de app" (myaccount.google.com/apppasswords).
# Se SMTP_HOST estiver preenchido, ele tem prioridade sobre o Resend. EMAIL_FROM = o endereco da conta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-app@gmail.com
# SMTP_PASS=senha-de-app-de-16-letras
# Opcao B: Resend (resend.com), abaixo. Precisa de dominio verificado pra entregar a qualquer pessoa.
# Sem RESEND_API_KEY o backend nao quebra, mas o e-mail nao e' enviado (o link so' vai pro log).
RESEND_API_KEY=re_troque-pela-chave-do-resend
# O remetente padrao (onboarding@resend.dev) so' entrega pro e-mail dono da conta Resend.
# Pra enviar pra qualquer usuario, verifique um dominio no Resend e use ex.: Meu Bolso Digital <nao-responda@seudominio.com.br>
EMAIL_FROM=Meu Bolso Digital <onboarding@resend.dev>

# --- Cloudflare Tunnel (container "cloudflared") ---
# Token do tunnel, gerado no passo "Criar o tunnel" do DEPLOY.md (Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=troque-pelo-token-do-tunnel
