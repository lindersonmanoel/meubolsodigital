# Copie para ".env" e preencha. O arquivo ".env" nunca deve ir para o Git.

# Ambiente: development | production | test
NODE_ENV=development

# Porta em que a API escuta
PORT=3000

# Conexao com o PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/meu_bolso_digital

# Em produção (ex.: banco gerenciado), a maioria exige SSL. Deixe "true" nesse caso.
DATABASE_SSL=false

# Segredo usado para assinar os tokens JWT. Gere um valor aleatorio forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Por quanto tempo o token de login fica valido
JWT_EXPIRES_IN=7d

# Endereco do frontend (para liberar no CORS). Em desenvolvimento local, a porta do Live Server por exemplo.
FRONTEND_URL=http://localhost:5500
