# Copie para ".env" e preencha. O arquivo ".env" nunca deve ir para o Git.

# Ambiente: development | production | test
NODE_ENV=development

# Porta em que a API escuta
PORT=3000

# Conexao com o PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/meu_bolso_digital

# Em produção (ex.: banco gerenciado), a maioria exige SSL. Deixe "true" nesse caso.
DATABASE_SSL=false

# Opcional: certificado da CA do provedor (PEM), para validar o certificado do banco em vez
# de aceitar qualquer um. Sem isso, com DATABASE_SSL=true a conexao fica sem verificar a
# cadeia (comum em Railway/Heroku com certificado autoassinado).
DATABASE_SSL_CA=

# Segredo usado para assinar os tokens JWT. Gere um valor aleatorio forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Por quanto tempo o token de login fica valido
JWT_EXPIRES_IN=7d

# Endereco do frontend (para liberar no CORS, e usado no link do e-mail de recuperacao de senha).
# Em desenvolvimento local, a porta do Live Server por exemplo.
FRONTEND_URL=http://localhost:5500

# Chave da API do Resend (resend.com), usada pra mandar o e-mail de "esqueci minha senha".
# Sem isso, o link fica so' no log do servidor (util em dev/teste) - nao quebra o fluxo,
# so nao manda o e-mail de verdade.
RESEND_API_KEY=

# Remetente do e-mail de recuperacao de senha. O padrao (onboarding@resend.dev) funciona sem
# verificar dominio proprio no Resend, so' pra testar; pra producao vale a pena verificar um
# dominio (ex.: "Meu Bolso Digital <naoresponda@seudominio.com>").
EMAIL_FROM=Meu Bolso Digital <onboarding@resend.dev>
